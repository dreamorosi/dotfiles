# Brewfile - macOS package management via `brew bundle`
# Run with:  brew bundle --file=Brewfile
# bootstrap.sh runs this automatically on macOS.

# --- Formulae ---
brew "awscli"
brew "fnm"        # Node version manager
brew "gh"         # GitHub CLI
brew "git"
brew "neovim"     # editor (LazyVim config in .config/nvim)
brew "ripgrep"    # rg

# --- Casks ---
cask "claude-code"
cask "finch"      # container runtime (CDK_DOCKER=finch on macOS)
cask "ghostty"    # terminal
cask "obsidian"

# --- Fonts ---
cask "font-fira-code"
